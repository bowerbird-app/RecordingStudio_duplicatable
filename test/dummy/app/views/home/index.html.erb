<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Duplicatable Demo",
    subtitle: "Pages duplicate with their comment recordings. Reports duplicate without comment recordings, using only the addon API configuration.",
    variant: :h1
  ) %>

  <% if flash[:notice].present? %>
    <%= render FlatPack::Alert::Component.new(
      title: "Duplication complete",
      description: flash[:notice],
      style: :success
    ) %>
  <% elsif flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(
      title: "Duplication error",
      description: flash[:alert],
      style: :error
    ) %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Pages",
    subtitle: "Configured with `include_children: [\"Comment\"]` so duplicate page recordings also copy their child comments."
  ) %>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @pages.each do |page| %>
      <%= render "recordable_card",
        recordable: page,
        recordable_type_label: "Page",
        child_count: child_count_for(page),
        recordable_path: page_path(page.slug),
        duplicate_path: duplicate_page_path(page.slug) %>
    <% end %>
  </div>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Reports",
    subtitle: "Configured with `exclude_children: [\"Comment\"]` so duplicate reports leave their child comments behind."
  ) %>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @reports.each do |report| %>
      <%= render "recordable_card",
        recordable: report,
        recordable_type_label: "Report",
        child_count: child_count_for(report),
        recordable_path: report_path(report.slug),
        duplicate_path: duplicate_report_path(report.slug) %>
    <% end %>
  </div>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Folders",
    subtitle: "Configured with `include_children: [\"Folder\", \"Comment\"]` so nested folders duplicate recursively."
  ) %>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @folders.each do |folder| %>
      <%= render "recordable_card",
        recordable: folder,
        recordable_type_label: "Folder",
        child_count: child_count_for(folder),
        recordable_path: folder_path(folder.slug),
        duplicate_path: duplicate_folder_path(folder.slug) %>
    <% end %>
  </div>
</div>
