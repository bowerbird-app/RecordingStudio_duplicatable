<% recording_studio_page_nav(title: "Copy a page") %>
<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(
    text: "Sign out",
    style: :ghost,
    size: :md,
    url: destroy_user_session_path,
    data: { turbo_method: :delete }
  ) %>
<% end %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: "Copy a page",
    subtitle: "These cards post to the gem's built-in duplication endpoint. Pages copy comments, reports skip comments, and folders copy their nested tree.",
    variant: :h1
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 4, gap: :md) do %>
    <%= render FlatPack::Button::Component.new(text: "Setup", style: :secondary, size: :sm, url: guide_path("setup")) %>
    <%= render FlatPack::Button::Component.new(text: "Approach", style: :secondary, size: :sm, url: guide_path("approach")) %>
    <%= render FlatPack::Button::Component.new(text: "Use", style: :secondary, size: :sm, url: guide_path("use")) %>
    <%= render FlatPack::Button::Component.new(text: "Methods", style: :secondary, size: :sm, url: guide_path("methods")) %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Pages",
    subtitle: "Configured with `include_children: [\"Comment\"]` so duplicate page recordings also copy their child comments."
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <% @pages.each do |page| %>
      <%= render "recordable_card",
        recordable: page,
        recordable_type_label: "Page",
        child_count: child_count_for(page),
        recordable_path: page_path(page.slug),
        duplicate_path: duplicate_recording_path_for(page) %>
    <% end %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Reports",
    subtitle: "Configured with `exclude_children: [\"Comment\"]` so duplicate reports leave their child comments behind."
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <% @reports.each do |report| %>
      <%= render "recordable_card",
        recordable: report,
        recordable_type_label: "Report",
        child_count: child_count_for(report),
        recordable_path: report_path(report.slug),
        duplicate_path: duplicate_recording_path_for(report) %>
    <% end %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Folders",
    subtitle: "Configured with `include_children: [\"Folder\", \"Comment\"]` so nested folders duplicate recursively."
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <% @folders.each do |folder| %>
      <%= render "recordable_card",
        recordable: folder,
        recordable_type_label: "Folder",
        child_count: child_count_for(folder),
        recordable_path: folder_path(folder.slug),
        duplicate_path: duplicate_recording_path_for(folder) %>
    <% end %>
  <% end %>
<% end %>
