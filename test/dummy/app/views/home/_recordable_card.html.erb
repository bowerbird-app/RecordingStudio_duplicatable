<%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
  <% card.body do %>
    <article style="display: grid; gap: 1rem;">
      <%= render FlatPack::PageTitle::Component.new(
        title: recordable_title(recordable),
        subtitle: recordable_subtitle(recordable),
        variant: :h3
      ) %>

      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <%= render FlatPack::Badge::Component.new(text: recordable_type_label, style: :info, size: :sm) %>
        <%= render FlatPack::Badge::Component.new(text: "#{child_count} children", style: :default, size: :sm) %>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <%= render FlatPack::Button::Component.new(
          text: "Show",
          style: :ghost,
          size: :sm,
          url: recordable_path
        ) %>

        <% if duplicate_path.present? %>
          <%= form_with url: duplicate_path, method: :post, local: true do %>
            <%= render FlatPack::Button::Component.new(
              text: "Duplicate",
              style: :primary,
              size: :sm,
              type: "submit"
            ) %>
          <% end %>
        <% end %>
      </div>
    </article>
  <% end %>
<% end %>
