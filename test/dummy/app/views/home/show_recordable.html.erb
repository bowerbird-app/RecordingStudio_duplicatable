<div style="display: grid; gap: 1.5rem;">
  <%= render FlatPack::PageTitle::Component.new(
    title: recordable_title(@recordable),
    subtitle: recordable_subtitle(@recordable),
    variant: :h1
  ) %>

  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
    <%= render FlatPack::Badge::Component.new(text: @recordable_type_label, style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "#{@child_recordings.size} children", style: :default, size: :sm) %>
  </div>

  <% if @recordable.is_a?(Folder) && @child_folder_recordings.any? %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Child folders",
      subtitle: "Open the next level to confirm the nested folders are real.",
      anchor_link: true
    ) %>

    <%= render FlatPack::Table::Component.new(data: @child_folder_recordings) do |table| %>
      <% table.column(title: "Folder", html: ->(child_recording) { child_recording_title(child_recording) }) %>
      <% table.column(title: "Open", html: ->(child_recording) { child_recording_link(child_recording) }) %>
    <% end %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Children",
    subtitle: "Direct child recordings attached to this #{@recordable_type_label.downcase}.",
    anchor_link: true
  ) %>

  <%= render FlatPack::Table::Component.new(data: @child_recordings) do |table| %>
    <% table.column(title: "Type", html: ->(child_recording) { child_recording.recordable_type }) %>
    <% table.column(title: "Title", html: ->(child_recording) { child_recording_title(child_recording) }) %>
    <% table.column(title: "Open", html: ->(child_recording) { child_recording_link(child_recording) }) %>
  <% end %>
</div>
