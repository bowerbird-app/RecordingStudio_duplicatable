<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    subtitle: @page.summary,
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <div class="space-y-4 text-sm leading-7 text-[var(--surface-content-color)]">
        <%= simple_format(@page.body) %>
      </div>
    <% end %>
  <% end %>

  <% if @page.code_sample.present? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Example",
          subtitle: "A small snippet you can copy into a host app.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <pre class="overflow-x-auto rounded-lg bg-[var(--surface-raised-background-color)] p-4 text-xs leading-6"><code><%= @page.code_sample %></code></pre>
      <% end %>
    <% end %>
  <% end %>

  <% if @api_methods.present? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Duplicatable API",
          subtitle: "The main entry points exposed by the addon.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-4 text-sm">
          <% @api_methods.each do |method| %>
            <li>
              <div class="font-mono text-xs text-[var(--surface-content-color)]"><%= method[:name] %></div>
              <div class="text-[var(--surface-muted-content-color)]"><%= method[:description] %></div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
</div>
