<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Duplicatable",
      subtitle: "Demo"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: root_path,
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Setup",
        href: guide_path("setup"),
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Approach",
        href: guide_path("approach"),
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Use",
        href: guide_path("use"),
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "JSON API",
        href: guide_path("api"),
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Methods",
        href: guide_path("methods"),
        icon: :folder
      ) %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: destroy_user_session_path,
        icon: :lock,
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
