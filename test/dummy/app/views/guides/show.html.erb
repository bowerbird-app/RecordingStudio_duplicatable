<div style="display: grid; gap: 1.5rem;">
  <%= render FlatPack::PageTitle::Component.new(
    title: @guide[:title],
    subtitle: @guide[:subtitle],
    variant: :h1
  ) %>

  <% @guide[:sections].each do |section| %>
    <section<%= section[:anchor].present? ? %( id="#{section[:anchor]}") : "" %> style="display: grid; gap: 1rem;">
      <% if section[:title].present? || section[:subtitle].present? %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: section[:title],
          subtitle: section[:subtitle],
          anchor_link: true
        ) %>
      <% end %>

      <% if section[:table].present? %>
        <%= render FlatPack::Table::Component.new(data: section[:table][:data]) do |table| %>
          <% section[:table][:data].first.keys.each do |column_name| %>
            <% table.column(title: column_name.to_s.humanize, html: ->(row) { row[column_name] }) %>
          <% end %>
        <% end %>
      <% end %>

      <% if section[:list].present? %>
        <% if section[:list][:ordered] %>
          <ol style="margin: 0; padding-left: 1.25rem;">
            <% section[:list][:items].each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ol>
        <% else %>
          <ul style="margin: 0; padding-left: 1.25rem;">
            <% section[:list][:items].each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <% if section[:code_block].present? %>
        <%= render FlatPack::CodeBlock::Component.new(
          title: section[:code_block][:title],
          code: section[:code_block][:code],
          language: section[:code_block][:language]
        ) %>
      <% end %>
    </section>
  <% end %>
</div>
